#!/bin/bash
#SBATCH --partition=math-alderaan
#SBATCH --job-name=pa_dl_in
#SBATCH --array=1-6
#SBATCH --mem=8G
#SBATCH --time=1-0:00:00
#SBATCH --output=/home/ges/chungmin/logs/%x_%A_%a.out
#SBATCH --error=/home/ges/chungmin/logs/%x_%A_%a.err
#SBATCH --chdir=/home/ges/chungmin

module purge
source /data001/projects/chungmin/miniconda3/etc/profile.d/conda.sh
conda activate MC0617

export TMPDIR=/data002/scratch/$USER/tmp
mkdir -p logs

# Optional: download per-sensor history from native PA API.
# Not needed if EPA RSIG data is already on disk.
# Requires: export PA_READ_KEY=XXXX before submitting.
# Array 1-6 → years 2020-2025.
export PA_READ_KEY="${PA_READ_KEY:?PA_READ_KEY is not set. Export before submitting.}"
echo "Task ${SLURM_ARRAY_TASK_ID} | Year $((2019 + SLURM_ARRAY_TASK_ID)) | indoor"
Rscript acq_pa_download.R "${SLURM_ARRAY_TASK_ID}" indoor
