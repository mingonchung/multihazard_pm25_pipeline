#!/bin/bash
#SBATCH --partition=math-alderaan
#SBATCH --job-name=pa_loc_shp
#SBATCH --mem=32G
#SBATCH --time=0-4:00:00
#SBATCH --output=/home/ges/chungmin/logs/%x_%j.out
#SBATCH --error=/home/ges/chungmin/logs/%x_%j.err
#SBATCH --chdir=/home/ges/chungmin

module purge
source /data001/projects/chungmin/miniconda3/etc/profile.d/conda.sh
conda activate MC0617

export TMPDIR=/data002/scratch/$USER/tmp
mkdir -p logs

# Build PA sensor location shapefiles from sensor_list CSVs (created by combine).
# Runs after all combine jobs complete. Produces base shp + us_attrs shp.
# Prerequisite: sensor_list_{type}.csv must exist (created by combine step).
echo "Building sensor location shapefiles (outdoor + indoor)"
Rscript util_pa_sensor_location_shp.R outdoor
Rscript util_pa_sensor_location_shp.R indoor
