#!/bin/bash
#SBATCH --partition=math-alderaan
#SBATCH --job-name=pa_stg02
#SBATCH --mem=100G
#SBATCH --time=1-0:00:00
#SBATCH --output=/home/ges/chungmin/logs/%x_%j.out
#SBATCH --error=/home/ges/chungmin/logs/%x_%j.err
#SBATCH --chdir=/home/ges/chungmin

module purge
source /data001/projects/chungmin/miniconda3/etc/profile.d/conda.sh
conda activate MC0617

export TMPDIR=/data002/scratch/$USER/tmp
mkdir -p logs

# Stage 02: assign HMS smoke density + FIRED fire flags to PA sensor locations.
# Reads daily hms_smoke_fired_YYYYMMDD.shp from AirNow stage01 (already on disk).
# Prerequisite: stage01_hms_fired_join.R must have completed (AirNow pipeline).
Rscript stage02_pa_sensor_smoke_fire_assign.R outdoor
Rscript stage02_pa_sensor_smoke_fire_assign.R indoor
