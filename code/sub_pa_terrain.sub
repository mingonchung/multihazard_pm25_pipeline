#!/bin/bash
#SBATCH --partition=math-alderaan
#SBATCH --job-name=pa_terrain
#SBATCH --array=1-2
#SBATCH --mem=32G
#SBATCH --time=3-0:00:00
#SBATCH --output=/home/ges/chungmin/logs/%x_%A_%a.out
#SBATCH --error=/home/ges/chungmin/logs/%x_%A_%a.err
#SBATCH --chdir=/home/ges/chungmin

module purge
source /data001/projects/chungmin/miniconda3/etc/profile.d/conda.sh
conda activate MC0617

export TMPDIR=/data002/scratch/$USER/tmp
mkdir -p logs

# Extracts elevation, slope, and aspect for each PurpleAir sensor location
# from AWS Terrain Tiles (Mapzen) at zoom level 12 (~20-30 m resolution).
# Array 1=outdoor, 2=indoor.
# Reads  FILE_PA_{TYPE}_LOC_SHP  (from util_pa_sensor_location_shp.R)
# Writes FILE_PA_{TYPE}_TERRAIN_SHP
# Required by: stage09_pa_attribute_join.R
# NOTE: Requires internet access for AWS tile downloads.
case "${SLURM_ARRAY_TASK_ID}" in
  1) echo "Terrain extract outdoor" ; Rscript util_pa_terrain_extract.R outdoor ;;
  2) echo "Terrain extract indoor"  ; Rscript util_pa_terrain_extract.R indoor  ;;
esac
